{
  "ConnectionStrings": {
    "ClaimsDatabase": "Data Source=claims.db"
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "Topic": "claim-events",
    "ConsumerGroup": "claims-notifications"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
